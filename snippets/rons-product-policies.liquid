{% comment %}
  Ron's Pijamas – "Delivery and returns" accordion on the product page.
  Links to the store's real Shopify policies (Settings › Policies) and shows
  an optional short summary. Renders nothing when neither policy exists and
  no summary is set.

  Accepts:
  - block: {Object} the rons_policies block
  - section_id: {String} the product section id

  Usage:
  {% render 'rons-product-policies', block: block, section_id: section.id %}
{% endcomment %}

{%- liquid
  assign has_shipping_policy = false
  if shop.shipping_policy.body != blank
    assign has_shipping_policy = true
  endif
  assign has_refund_policy = false
  if shop.refund_policy.body != blank
    assign has_refund_policy = true
  endif
-%}
{%- if has_shipping_policy or has_refund_policy or block.settings.summary != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: block.settings.icon %}
          <h2 class="h4 accordion__title inline-richtext">{{ block.settings.heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section_id }}">
        {{ block.settings.summary }}
        {%- if has_shipping_policy or has_refund_policy -%}
          <ul class="rons-policy-links list-unstyled">
            {%- if has_shipping_policy -%}
              <li>
                <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a>
              </li>
            {%- endif -%}
            {%- if has_refund_policy -%}
              <li>
                <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}
