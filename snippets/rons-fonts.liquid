{% comment %}
  Ron's Pijamas – self-hosted brand fonts with Latin and Bulgarian Cyrillic.

  Shopify's font library only ships Latin glyphs, so Cyrillic text would fall
  back to system fonts. These OFL-licensed files (see FONTS-LICENSE.md) cover
  both scripts with the same design:
  - Headings: Cormorant Garamond 500
  - Body: Jost 400 / 500 / 600 (600 is used for bold)

  unicode-range lets the browser download only the subsets a page needs.
  The two files used above the fold are preloaded, picking the Cyrillic
  subset for Bulgarian and the Latin subset for other languages.

  Rendered from layout/theme.liquid when Theme settings > Typography
  (Cyrillic) > "Use Ron's Pijamas fonts" is on. Overrides the font variables
  Dawn sets from the font pickers.

  Usage:
  {% render 'rons-fonts' %}
{% endcomment %}

{%- liquid
  assign latin_range = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
  assign cyrillic_range = 'U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116'
  assign subsets = 'latin,cyrillic' | split: ','
  assign body_weights = '400,500,600' | split: ','
  if request.locale.iso_code == 'bg'
    assign preload_subset = 'cyrillic'
  else
    assign preload_subset = 'latin'
  endif
-%}

{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link
  rel="preload"
  as="font"
  href="{{ 'rons-jost-' | append: preload_subset | append: '-400.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
<link
  rel="preload"
  as="font"
  href="{{ 'rons-cormorant-garamond-' | append: preload_subset | append: '-500.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
{% comment %}theme-check-enable AssetPreload{% endcomment %}

{% style %}
  {%- for subset in subsets -%}
    {%- if subset == 'latin' -%}
      {%- assign range = latin_range -%}
    {%- else -%}
      {%- assign range = cyrillic_range -%}
    {%- endif -%}
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url('{{ 'rons-cormorant-garamond-' | append: subset | append: '-500.woff2' | asset_url }}') format('woff2');
      unicode-range: {{ range }};
    }
    {%- for weight in body_weights %}
      @font-face {
        font-family: 'Jost';
        font-style: normal;
        font-weight: {{ weight }};
        font-display: swap;
        src: url('{{ 'rons-jost-' | append: subset | append: '-' | append: weight | append: '.woff2' | asset_url }}') format('woff2');
        unicode-range: {{ range }};
      }
    {%- endfor -%}
  {%- endfor %}

  :root {
    --font-heading-family: 'Cormorant Garamond', 'Times New Roman', Georgia, serif;
    --font-heading-style: normal;
    --font-heading-weight: 500;
    --font-body-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 600;
  }
{% endstyle %}
