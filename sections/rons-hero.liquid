{% comment %}
  Ron’s Pijamas – editorial hero slider (homepage).

  Each "Slide" block is one slide (add, reorder, hide or remove them in the
  Theme Editor). Slide types:
  - Editorial split: text beside a dominant photo on desktop (the original
    hero design), photo with text on phones.
  - Full-width photo with text on it.
  - Full-width image banner: a finished campaign image without HTML text;
    the whole banner is one link and is never stretched (shown whole by
    default, or filling the slide with its focal point).
  Separate desktop and mobile images in one <picture>, so phones only
  download the mobile image; each falls back to the other.

  All slides share one height (the section's height settings) and are
  stacked in one grid cell, so changing slides never shifts the page. Only
  the first slide's image loads with high priority; the others are lazy.
  <rons-hero-slider> in assets/rons-custom.js adds arrows, dots, swipe and
  autoplay. With one visible slide there are no controls and no autoplay.

  A slide is skipped on the storefront when it is hidden, has no image
  (banner) or has neither an image nor text (other types). The Theme Editor
  shows those slides with a hint instead.
{% endcomment %}

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign visible_count = 0
  for block in slides
    if block.settings.enabled == false
      continue
    endif
    assign b_image = block.settings.image_desktop | default: block.settings.image_mobile
    if block.settings.slide_type == 'image'
      if b_image != blank
        assign visible_count = visible_count | plus: 1
      endif
    elsif b_image != blank or block.settings.heading != blank or block.settings.text != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  if request.design_mode
    assign render_count = slides.size
  else
    assign render_count = visible_count
  endif

  assign has_main_slide = false
  for block in slides
    if block.settings.main_slide and block.settings.enabled != false and block.settings.heading != blank
      assign has_main_slide = true
    endif
  endfor

  assign show_badge = false
  if section.settings.show_badge
    if settings.trust_badge_rating != blank or settings.trust_badge_text != blank
      assign show_badge = true
    endif
  endif

  assign slider = false
  if render_count > 1
    assign slider = true
  endif
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
-%}

{%- if render_count > 0 -%}
  <rons-hero-slider
    class="rons-hero-slider{% if slider %} rons-hero-slider--multi{% endif %}"
    {% if slider %}
      role="region"
      aria-roledescription="карусел"
      aria-label="Акценти от Ron’s Pijamas"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ autoplay_ms }}"
    {% endif %}
  >
    <div class="rons-hero-slider__track" data-track>
      {%- assign slide_index = 0 -%}
      {%- assign heading_tag_used = false -%}
      {%- assign badge_used = false -%}
      {%- assign main_taken = false -%}
      {%- for block in slides -%}
        {%- liquid
          assign image_desktop = block.settings.image_desktop
          assign image_mobile = block.settings.image_mobile
          assign main_image = image_desktop | default: image_mobile
          assign mobile_image = image_mobile | default: image_desktop
          assign has_image = false
          if main_image != blank
            assign has_image = true
          endif
          assign is_banner = false
          if block.settings.slide_type == 'image'
            assign is_banner = true
          endif

          assign show_button = false
          if block.settings.button_label != blank and block.settings.link != blank
            assign show_button = true
          endif
          assign is_main = false
          if has_main_slide and main_taken != true and block.settings.main_slide and block.settings.enabled != false and block.settings.heading != blank
            assign is_main = true
            assign main_taken = true
          endif
          assign has_text = false
          if is_banner == false
            if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or show_button
              assign has_text = true
            endif
            if show_badge
              if has_main_slide
                if is_main
                  assign has_text = true
                endif
              elsif badge_used == false
                assign has_text = true
              endif
            endif
          endif

          assign is_visible = true
          if block.settings.enabled == false
            assign is_visible = false
          elsif is_banner and has_image == false
            assign is_visible = false
          elsif has_image == false and has_text == false
            assign is_visible = false
          endif
          if is_visible == false and request.design_mode == false
            continue
          endif

          if slide_index == 0 and section.index <= 2
            assign loading = 'eager'
            assign fetch_priority = 'high'
          else
            assign loading = 'lazy'
            assign fetch_priority = 'low'
          endif

          assign alt = block.settings.image_alt | default: main_image.alt | default: block.settings.heading | strip_html

          if is_banner
            assign layout = 'banner'
          else
            assign layout = block.settings.slide_type
          endif

          assign slide_side = block.settings.image_side
          if slide_side == blank or slide_side == 'section'
            assign slide_side = section.settings.image_side
          endif
          assign slide_text = block.settings.text_color
          if slide_text == blank or slide_text == 'section'
            assign slide_text = section.settings.text_color
          endif
          assign crop_side = block.settings.image_crop | default: 'none'
          if is_banner or has_image == false
            assign crop_side = 'none'
          endif

          capture hero_classes
            echo 'rons-hero'
            echo ' rons-hero--layout-' | append: layout
            echo ' rons-hero--image-' | append: slide_side
            echo ' rons-hero--text-' | append: slide_text
            echo ' rons-hero--desktop-' | append: section.settings.desktop_height
            echo ' rons-hero--mobile-' | append: section.settings.mobile_height
            if is_banner
              echo ' rons-hero--fit-' | append: block.settings.image_fit
              if image_mobile == blank
                echo ' rons-hero--banner-no-mobile'
              endif
            else
              echo ' rons-hero--overlay-' | append: section.settings.overlay_style
              if section.settings.text_below_desktop
                echo ' rons-hero--below-desktop'
              endif
              if section.settings.text_below_mobile
                echo ' rons-hero--below-mobile'
              endif
            endif
            if has_image == false
              if request.design_mode
                echo ' rons-hero--placeholder'
              else
                echo ' rons-hero--no-image'
              endif
            endif
            if is_visible == false
              echo ' rons-hero--editor-hidden'
            endif
          endcapture
        -%}
        <div
          class="rons-hero-slider__slide{% if slide_index == 0 %} is-active{% endif %}"
          data-slide
          {% if slider %}
            role="group" aria-roledescription="слайд" aria-label="{{ slide_index | plus: 1 }} от {{ render_count }}"
            {% unless slide_index == 0 %}
              aria-hidden="true" inert
            {% endunless %}
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- capture slide_media -%}
            {%- if has_image and crop_side != 'none' -%}
              {%- comment -%}
                Use only one side of a wide image (e.g. the photo half of a campaign
                banner): Shopify's CDN crops a near-square frame from that side.
              {%- endcomment -%}
              {%- liquid
                assign crop_h = main_image.height
                assign crop_w = crop_h | times: 1.06 | round
                if crop_w > main_image.width
                  assign crop_w = main_image.width
                endif
                assign crop_srcset = ''
                for w in (1..4)
                  assign cw = w | times: 300
                  if cw < crop_w
                    assign ch = cw | times: crop_h | divided_by: crop_w
                    assign crop_srcset = crop_srcset | append: main_image | image_url: width: cw, height: ch, crop: crop_side | append: ' ' | append: cw | append: 'w, '
                  endif
                endfor
                assign crop_srcset = crop_srcset | append: main_image | image_url: width: crop_w, height: crop_h, crop: crop_side | append: ' ' | append: crop_w | append: 'w'
              -%}
              <picture>
                {%- if image_mobile != blank and image_desktop != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ image_mobile | image_url: width: 450 }} 450w,
                      {{ image_mobile | image_url: width: 750 }} 750w,
                      {{ image_mobile | image_url: width: 1100 }} 1100w,
                      {{ image_mobile | image_url: width: 1500 }} 1500w
                    "
                    sizes="100vw"
                    width="{{ image_mobile.width }}"
                    height="{{ image_mobile.height }}"
                  >
                {%- endif -%}
                <img
                  class="rons-hero__image"
                  src="{{ main_image | image_url: width: crop_w, height: crop_h, crop: crop_side }}"
                  srcset="{{ crop_srcset }}"
                  sizes="(min-width: 750px) 60vw, 100vw"
                  width="{{ crop_w }}"
                  height="{{ crop_h }}"
                  alt="{{ alt | escape }}"
                  loading="{{ loading }}"
                  fetchpriority="{{ fetch_priority }}"
                >
              </picture>
            {%- elsif has_image -%}
              <picture>
                {%- if image_mobile != blank and image_desktop != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ image_mobile | image_url: width: 450 }} 450w,
                      {{ image_mobile | image_url: width: 750 }} 750w,
                      {{ image_mobile | image_url: width: 1100 }} 1100w,
                      {{ image_mobile | image_url: width: 1500 }} 1500w
                    "
                    sizes="100vw"
                    width="{{ image_mobile.width }}"
                    height="{{ image_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  main_image
                  | image_url: width: 3000
                  | image_tag:
                    class: 'rons-hero__image',
                    widths: '450, 750, 1100, 1500, 1920, 2400, 3000',
                    sizes: '100vw',
                    loading: loading,
                    fetchpriority: fetch_priority,
                    alt: alt
                }}
              </picture>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg rons-hero__placeholder' }}
              <p class="rons-editor-hint rons-hero__hint">
                {%- if block.settings.enabled == false -%}
                  Този слайд е скрит („Show this slide“ е изключено).
                {%- elsif is_banner -%}
                  Добави банер за десктоп и (по желание) мобилен банер. Без изображение слайдът не се показва на клиентите.
                {%- else -%}
                  Добави снимка за десктоп и мобилна снимка.
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- endcapture -%}

          <div
            class="{{ hero_classes | strip }}"
            style="--rons-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};{% if has_image %} --rons-hero-ratio: {{ main_image.aspect_ratio }}; --rons-hero-ratio-mobile: {{ mobile_image.aspect_ratio }}; --rons-hero-focal: {{ main_image.presentation.focal_point }}; --rons-hero-focal-mobile: {{ mobile_image.presentation.focal_point }};{% endif %}{% if is_banner %} --rons-hero-banner-bg: {{ block.settings.banner_background }};{% endif %}"
          >
            {%- if is_banner -%}
              {%- if block.settings.link != blank and has_image -%}
                <a href="{{ block.settings.link }}" class="rons-hero__media rons-hero__banner-link">
                  {{- slide_media -}}
                </a>
              {%- else -%}
                <div class="rons-hero__media">{{ slide_media }}</div>
              {%- endif -%}
            {%- else -%}
              {%- if has_image or request.design_mode -%}
                <div class="rons-hero__media">{{ slide_media }}</div>
              {%- endif -%}

              {%- if layout == 'editorial' and block.settings.detail_image != blank -%}
                <div class="rons-hero__detail" aria-hidden="true">
                  {{
                    block.settings.detail_image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 18vw, 1px', alt: ''
                  }}
                </div>
              {%- endif -%}

              {%- if has_text -%}
                <div class="rons-hero__content page-width rons-hero__content--{{ section.settings.desktop_position }} rons-hero__content--mobile-{{ section.settings.mobile_alignment }}">
                  <div class="rons-hero__box">
                    {%- liquid
                      assign badge = ''
                      assign badge_here = false
                      if show_badge
                        if has_main_slide
                          if is_main
                            assign badge_here = true
                          endif
                        elsif badge_used == false
                          assign badge_here = true
                        endif
                      endif
                      if badge_here
                        capture badge
                          render 'rons-trust-badge', link: section.settings.badge_link, class: 'rons-hero__badge'
                        endcapture
                        assign badge_used = true
                      endif
                      if section.settings.badge_position == 'above_heading'
                        echo badge
                      endif
                    -%}
                    {%- if block.settings.eyebrow != blank -%}
                      <p class="rons-hero__eyebrow rons-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      {%- comment -%}
                        The first slide with a heading gets the section's heading tag
                        (H1 on the homepage), even when a banner slide comes first.
                      {%- endcomment -%}
                      {%- liquid
                        if has_main_slide
                          if is_main
                            assign rons_heading_tag = section.settings.heading_tag | default: 'h2'
                          else
                            assign rons_heading_tag = 'h2'
                          endif
                        elsif heading_tag_used
                          assign rons_heading_tag = 'h2'
                        else
                          assign rons_heading_tag = section.settings.heading_tag | default: 'h2'
                          assign heading_tag_used = true
                        endif
                      -%}
                      <{{ rons_heading_tag }} class="rons-hero__heading {{ section.settings.heading_size }}">{{ block.settings.heading }}</{{ rons_heading_tag }}>
                    {%- endif -%}
                    {%- if section.settings.badge_position == 'below_heading' %}{{ badge }}{% endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="rons-hero__text">{{ block.settings.text }}</p>
                    {%- endif -%}
                    {%- if show_button -%}
                      <div class="rons-hero__buttons">
                        <a href="{{ block.settings.link }}" class="button rons-hero__button rons-hero__button--primary">
                          {{- block.settings.button_label | escape -}}
                        </a>
                      </div>
                    {%- endif -%}
                    {%- if section.settings.badge_position == 'near_buttons' %}{{ badge }}{% endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
        {%- assign slide_index = slide_index | plus: 1 -%}
      {%- endfor -%}
    </div>

    {%- if slider -%}
      <div class="rons-hero-slider__controls" data-controls>
        <button type="button" class="rons-hero-slider__arrow" data-prev aria-label="Предишен слайд">
          <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
        <div class="rons-hero-slider__dots" data-dots>
          {%- for i in (1..render_count) -%}
            <button
              type="button"
              class="rons-hero-slider__dot"
              data-dot="{{ forloop.index0 }}"
              aria-label="Слайд {{ i }} от {{ render_count }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            ></button>
          {%- endfor -%}
        </div>
        <button type="button" class="rons-hero-slider__arrow rons-hero-slider__arrow--next" data-next aria-label="Следващ слайд">
          <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
      </div>
    {%- endif -%}
  </rons-hero-slider>
{%- endif -%}

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "class": "section rons-hero-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Each slide is a block: add, drag to reorder, hide or remove slides in the left sidebar. A slide without an image (and, for editorial slides, without text) is skipped on the storefront."
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Pauses on hover, keyboard focus and when the visitor uses the slider. Off for visitors who prefer reduced motion and when only one slide is shown."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side (editorial split)",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "adapt",
          "label": "Fit to image"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large",
      "info": "Editorial split is capped at 860 px so the photo never feels oversized."
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "adapt",
          "label": "Fit to image"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Text on image"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Readability overlay",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "gradient",
          "label": "Gradient behind text"
        },
        {
          "value": "solid",
          "label": "Even shade"
        }
      ],
      "default": "gradient",
      "info": "Use only when the text is hard to read on the photo."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "default": 35
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text colour on image",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "dark",
          "label": "Black"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Desktop text position",
      "options": [
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "middle-right",
          "label": "Middle right"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom-left",
      "info": "Used by the full-width layout."
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "text_below_desktop",
      "label": "Show text below the image on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "text_below_mobile",
      "label": "Show text below the image on mobile",
      "info": "Keeps the full photo visible on phones.",
      "default": false
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "info": "The first slide that has a heading uses this tag (use H1 on the homepage). Other slides use H2.",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h1",
          "label": "H1"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra large"
        }
      ],
      "default": "h0"
    },
    {
      "type": "header",
      "content": "Trust badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show trust badge",
      "info": "Text and star colour are set once in Theme settings › Значка за доверие. Only turn on when the figures are accurate and can be backed up.",
      "default": false
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Badge position",
      "options": [
        {
          "value": "above_heading",
          "label": "Above the heading"
        },
        {
          "value": "below_heading",
          "label": "Below the heading"
        },
        {
          "value": "near_buttons",
          "label": "Below the buttons"
        }
      ],
      "default": "above_heading"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link (optional)",
      "info": "Overrides the link from Theme settings for this banner."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 8,
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this slide",
          "default": true
        },
        {
          "type": "select",
          "id": "slide_type",
          "label": "Slide type",
          "default": "editorial",
          "options": [
            {
              "value": "editorial",
              "label": "Editorial split (text beside photo)"
            },
            {
              "value": "full",
              "label": "Full-width photo with text on it"
            },
            {
              "value": "image",
              "label": "Image banner (no text, whole banner links)"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "main_slide",
          "label": "Main slide (H1 heading and trust badge)",
          "default": false,
          "info": "Tick on one slide only. Without it, the first slide with a heading gets the H1."
        },
        {
          "type": "select",
          "id": "image_side",
          "label": "Photo side (editorial split)",
          "default": "section",
          "options": [
            {
              "value": "section",
              "label": "As set on the section"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text colour on the photo (phones)",
          "default": "section",
          "options": [
            {
              "value": "section",
              "label": "As set on the section"
            },
            {
              "value": "light",
              "label": "White"
            },
            {
              "value": "dark",
              "label": "Black"
            }
          ]
        },
        {
          "type": "image_picker",
