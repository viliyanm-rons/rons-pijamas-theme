{% comment %}
  Ron's Pijamas – editorial blog listing ("The Journal").

  Works with any Shopify blog (Online Store › Blog posts). Articles, images,
  tags, excerpts and dates come from Shopify; nothing is hardcoded.

  Layout: editorial hero (eyebrow, H1, subtitle, optional wide photo), tag
  filter built from the blog's real tags (hidden with fewer than two), one
  featured article (newest, first page, no tag filter), a 3/2/1 column grid
  and crawlable pagination. Structured data: BreadcrumbList.

  The H1 is the hero heading; when it is empty the blog's title is used.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: blog.title
  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '3 / 2'
  endcase
  assign show_tags = false
  if section.settings.show_tags and blog.all_tags.size > 1
    assign show_tags = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="rons-blog color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header class="rons-blog__hero">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rons-eyebrow rons-blog__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="rons-blog__title">{{ heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="rons-blog__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.hero_image != blank and current_tags == blank -%}
      <div class="rons-blog__hero-media">
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '(min-width: 1200px) 1200px, calc(100vw - 3rem)',
            alt: section.settings.hero_image.alt
        }}
      </div>
    {%- endif -%}

    {%- if show_tags -%}
      <nav class="rons-blog__tags" aria-label="{{ section.settings.tags_label | escape }}">
        <ul role="list">
          <li>
            <a
              href="{{ blog.url }}"
              class="rons-blog__tag{% if current_tags == blank %} is-active{% endif %}"
              {% if current_tags == blank %}
                aria-current="page"
              {% endif %}
            >
              {{- section.settings.all_label | escape -}}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            {%- assign tag_active = false -%}
            {%- if current_tags contains tag -%}{%- assign tag_active = true -%}{%- endif -%}
            <li>
              <a
                href="{{ blog.url }}/tagged/{{ tag | handle }}"
                class="rons-blog__tag{% if tag_active %} is-active{% endif %}"
                {% if tag_active %}
                  aria-current="page"
                {% endif %}
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.per_page -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="rons-blog__grid" role="list" style="--rons-blog-ratio: {{ ratio }};">
          {%- for article in blog.articles -%}
            {%- liquid
              assign featured = false
              if section.settings.feature_first and forloop.first and paginate.current_page == 1 and current_tags == blank
                assign featured = true
              endif
              assign eager = false
              if forloop.first and paginate.current_page == 1 and section.settings.hero_image == blank
                assign eager = true
              endif
              if article.excerpt != blank
                assign excerpt = article.excerpt | strip_html | truncatewords: 28
              else
                assign excerpt = article.content | strip_html | truncatewords: 28
              endif
            -%}
            <li class="rons-blog__item{% if featured %} rons-blog__item--featured{% endif %}">
              {% render 'rons-article-card',
                article: article,
                featured: featured,
                eager: eager,
                excerpt: excerpt,
                show_image: section.settings.show_image,
                show_tag: section.settings.show_tag,
                show_date: section.settings.show_date,
                show_excerpt: section.settings.show_excerpt,
                read_more_label: section.settings.read_more_label,
                heading_tag: 'h2',
                blog_url: blog.url
              %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- else -%}
        <div class="rons-blog__empty">
          {%- if section.settings.empty_text != blank -%}
            <p>{{ section.settings.empty_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.empty_button_label != blank -%}
            <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">
              {{- section.settings.empty_button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ section.settings.home_label | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ request.origin | append: blog.url | json }}
      }
    ]
  }
</script>

{% schema %}
{
  "name": "Блог – списък със статии",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Начало на страницата"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие (H1)",
      "default": "Красотата започва у дома",
      "info": "Ако е празно, се използва името на блога."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Подзаглавие",
      "default": "<p>Истории за женствеността, домашния стил, красивите ритуали и комфорта.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Широка снимка (по избор)",
      "info": "Поне 2400 px широка. Без снимка се показва само текстът."
    },
    {
      "type": "header",
      "content": "Теми"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Показвай филтър по теми",
      "default": true,
      "info": "Темите са таговете на статиите. Филтърът се показва, когато има поне две теми."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Бутон „всички“",
      "default": "Всички"
    },
    {
      "type": "text",
      "id": "tags_label",
      "label": "Име на филтъра за екранни четци",
      "default": "Теми"
    },
    {
      "type": "header",
      "content": "Статии"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Статии на страница",
      "min": 4,
      "max": 25,
      "step": 3,
      "default": 13,
      "info": "13 = една открояваща се статия и четири реда по три."
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "Открои най-новата статия",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Показвай основното изображение",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Пропорция на изображението",
      "options": [
        { "value": "landscape", "label": "Пейзаж (3:2)" },
        { "value": "portrait", "label": "Портрет (4:5)" },
        { "value": "square", "label": "Квадрат" }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Показвай темата",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Показвай датата",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Показвай откъс",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Текст на връзката",
      "default": "Прочети статията"
    },
    {
      "type": "header",
      "content": "Когато няма статии"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Текст",
      "default": "Все още няма публикувани статии."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Бутон към продуктите",
      "default": "Разгледай продуктите"
    },
    {
      "type": "header",
      "content": "Оформление"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "„Начало“ в структурираните данни",
      "default": "Начало"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Цветова схема",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Отстъп отгоре",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Отстъп отдолу",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
