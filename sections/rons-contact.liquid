{% comment %}
  Ron's Pijamas – contact page.

  Uses Shopify's native contact form: messages arrive at the store's
  sender email (Settings › Notifications). Field labels, the Bulgarian
  validation messages and the success message are section settings.

  Contact details are blocks (email, phone, text, social links). Nothing is
  prefilled: a block only shows once it has content, so no contact
  information is ever invented. Social links: the social block's own
  Facebook / Instagram / TikTok fields, falling back to Theme settings ›
  Social media; empty links are not shown.

  The optional phone is a standard Shopify contact form field
  (contact[...]); it appears in the notification email.

  Validation: the browser's own messages follow the visitor's browser
  language, so the form uses novalidate and assets/rons-custom.js shows the
  Bulgarian messages below. Shopify still validates on the server; its
  errors are shown with the same messages.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign form_id = 'RonsContactForm-' | append: section.id
  assign social_facebook = settings.social_facebook_link
  assign social_instagram = settings.social_instagram_link
  assign social_tiktok = settings.social_tiktok_link
  for block in section.blocks
    if block.type == 'social'
      if block.settings.facebook_url != blank
        assign social_facebook = block.settings.facebook_url
      endif
      if block.settings.instagram_url != blank
        assign social_instagram = block.settings.instagram_url
      endif
      if block.settings.tiktok_url != blank
        assign social_tiktok = block.settings.tiktok_url
      endif
    endif
  endfor
  assign has_social = false
  if social_facebook != blank or social_instagram != blank or social_tiktok != blank
    assign has_social = true
  endif
-%}

<div class="rons-contact color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="rons-contact__grid">
      <div class="rons-contact__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rons-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="rons-contact__title h0">{{ section.settings.heading | default: page.title | escape }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rons-contact__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- capture details -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'email' -%}
                {%- assign email = block.settings.email | strip -%}
                {%- if email != blank -%}
                  <div class="rons-contact__detail" {{ block.shopify_attributes }}>
                    <p class="rons-contact__label">{{ block.settings.label | escape }}</p>
                    <a href="mailto:{{ email | escape }}" class="link underlined-link">{{ email | escape }}</a>
                  </div>
                {%- endif -%}
              {%- when 'phone' -%}
                {%- assign phone = block.settings.phone | strip -%}
                {%- if phone != blank -%}
                  {%- assign phone_link = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '/' -%}
                  <div class="rons-contact__detail" {{ block.shopify_attributes }}>
                    <p class="rons-contact__label">{{ block.settings.label | escape }}</p>
                    <a href="tel:{{ phone_link | escape }}" class="link underlined-link">{{ phone | escape }}</a>
                  </div>
                {%- endif -%}
              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="rons-contact__detail" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank -%}
                      <p class="rons-contact__label">{{ block.settings.label | escape }}</p>
                    {%- endif -%}
                    <div class="rte">{{ block.settings.text }}</div>
                  </div>
                {%- endif -%}
              {%- when 'social' -%}
                {%- if has_social -%}
                  <div class="rons-contact__detail rons-contact__social" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank -%}
                      <p class="rons-contact__label">{{ block.settings.label | escape }}</p>
                    {%- endif -%}
                    <ul class="list-unstyled list-social rons-contact__social-list" role="list">
                      {%- if social_facebook != blank -%}
                        <li class="list-social__item">
                          <a href="{{ social_facebook }}" class="link list-social__link" target="_blank" rel="noopener noreferrer">
                            <span class="svg-wrapper">{{- 'icon-facebook.svg' | inline_asset_content -}}</span>
                            <span class="visually-hidden">Facebook ({{ 'accessibility.link_messages.new_window' | t }})</span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if social_instagram != blank -%}
                        <li class="list-social__item">
                          <a href="{{ social_instagram }}" class="link list-social__link" target="_blank" rel="noopener noreferrer">
                            <span class="svg-wrapper">{{- 'icon-instagram.svg' | inline_asset_content -}}</span>
                            <span class="visually-hidden">Instagram ({{ 'accessibility.link_messages.new_window' | t }})</span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if social_tiktok != blank -%}
                        <li class="list-social__item">
                          <a href="{{ social_tiktok }}" class="link list-social__link" target="_blank" rel="noopener noreferrer">
                            <span class="svg-wrapper">{{- 'icon-tiktok.svg' | inline_asset_content -}}</span>
                            <span class="visually-hidden">TikTok ({{ 'accessibility.link_messages.new_window' | t }})</span>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if details != blank -%}
          <div class="rons-contact__details">{{ details }}</div>
        {%- elsif request.design_mode -%}
          <p class="rons-editor-hint">
            Добави имейл, телефон или текст в блоковете на тази секция. Социалните мрежи се въвеждат в Настройки на
            темата › Социални мрежи. Празните блокове не се показват на клиентите.
          </p>
        {%- endif -%}
      </div>

      <div class="rons-contact__form-wrapper">
        {%- form 'contact', id: form_id, class: 'rons-contact__form', novalidate: 'novalidate' -%}
          {%- liquid
            assign error_email = false
            assign error_other = false
            if form.errors
              if form.errors contains 'email'
                assign error_email = true
              else
                assign error_other = true
              endif
            endif
          -%}
          {%- if form.posted_successfully? -%}
            <div class="rons-contact__status rons-contact__status--success" role="status" tabindex="-1" autofocus>
              <p>{{ section.settings.success_message | escape }}</p>
            </div>
          {%- elsif error_other -%}
            <div class="rons-contact__status rons-contact__status--error" role="alert" tabindex="-1" autofocus>
              <p>{{ section.settings.error_general | escape }}</p>
            </div>
          {%- endif -%}

          <div class="rons-contact__field" data-rons-field>
            <label for="{{ form_id }}-name" class="rons-contact__field-label">
              {{- section.settings.label_name | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="{{ form_id }}-name"
              class="rons-contact__input"
              type="text"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              autocomplete="name"
              required
              aria-required="true"
              data-rons-error="{{ section.settings.error_name | escape }}"
              aria-describedby="{{ form_id }}-name-error"
              value="{{ form.name }}"
            >
            <p id="{{ form_id }}-name-error" class="rons-contact__error" hidden></p>
          </div>

          <div class="rons-contact__field" data-rons-field>
            <label for="{{ form_id }}-phone" class="rons-contact__field-label">
              {{- section.settings.label_phone | escape }}
              <span class="rons-contact__optional">{{ section.settings.optional_label | escape }}</span>
            </label>
            <input
              id="{{ form_id }}-phone"
              class="rons-contact__input"
              type="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              autocomplete="tel"
              inputmode="tel"
              data-rons-optional
              data-rons-error="{{ section.settings.error_phone | escape }}"
              aria-describedby="{{ form_id }}-phone-error"
              value="{{ form.phone }}"
            >
            <p id="{{ form_id }}-phone-error" class="rons-contact__error" hidden></p>
          </div>

          <div class="rons-contact__field" data-rons-field>
            <label for="{{ form_id }}-email" class="rons-contact__field-label">
              {{- section.settings.label_email | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="{{ form_id }}-email"
              class="rons-contact__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              aria-required="true"
              data-rons-error="{{ section.settings.error_email | escape }}"
              {% if error_email %}
                aria-invalid="true"
              {% endif %}
              aria-describedby="{{ form_id }}-email-error"
              value="{{ form.email }}"
            >
            <p id="{{ form_id }}-email-error" class="rons-contact__error"{% unless error_email %} hidden{% endunless %}>
              {%- if error_email %}{{ section.settings.error_email | escape }}{% endif -%}
            </p>
          </div>

          <div class="rons-contact__field" data-rons-field>
            <label for="{{ form_id }}-body" class="rons-contact__field-label">
              {{- section.settings.label_message | escape }} <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="{{ form_id }}-body"
              class="rons-contact__input rons-contact__textarea"
              name="contact[body]"
              rows="6"
              required
              aria-required="true"
              data-rons-error="{{ section.settings.error_message | escape }}"
              aria-describedby="{{ form_id }}-body-error"
            >
              {{- form.body -}}
            </textarea>
            <p id="{{ form_id }}-body-error" class="rons-contact__error" hidden></p>
          </div>

          {%- if section.settings.required_note != blank -%}
            <p class="rons-contact__note">{{ section.settings.required_note | escape }}</p>
          {%- endif -%}

          <button type="submit" class="button button--full-width rons-contact__submit">
            {{- section.settings.submit_label | escape -}}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Контакти – форма",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие",
      "default": "Контакти"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "Свържи се с нас"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Въведение",
      "default": "<p>Имаш въпрос за продукт, размер или поръчка? Напиши ни чрез формата и ще ти отговорим.</p>"
    },
    {
      "type": "header",
      "content": "Полета на формата"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Име",
      "default": "Име"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Имейл",
      "default": "Имейл"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Телефон",
      "default": "Телефон"
    },
    {
      "type": "text",
      "id": "optional_label",
      "label": "Отбелязване на незадължително поле",
      "default": "(по желание)"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Съобщение",
      "default": "Съобщение"
    },
    {
      "type": "text",
      "id": "required_note",
      "label": "Бележка за задължителните полета",
      "default": "Полетата, отбелязани с *, са задължителни."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Бутон",
      "default": "Изпрати съобщение"
    },
    {
      "type": "header",
      "content": "Съобщения"
    },
    {
      "type": "text",
      "id": "error_name",
      "label": "Липсващо име",
      "default": "Моля, въведи своето име."
    },
    {
      "type": "text",
      "id": "error_email",
      "label": "Невалиден имейл",
      "default": "Моля, въведи валиден имейл адрес, напр. ime@primer.bg."
    },
    {
      "type": "text",
      "id": "error_phone",
      "label": "Невалиден телефон",
      "default": "Моля, въведи валиден телефонен номер или остави полето празно."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Липсващо съобщение",
      "default": "Моля, напиши своето съобщение."
    },
    {
      "type": "text",
      "id": "error_general",
      "label": "Обща грешка",
      "default": "Съобщението не беше изпратено. Моля, провери полетата и опитай отново."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Успешно изпратено",
      "default": "Благодарим ти! Съобщението ти е изпратено успешно."
    },
    {
      "type": "header",
      "content": "Оформление"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Цветова схема",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Отстъп отгоре",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Отстъп отдолу",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "email",
      "name": "Имейл",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Етикет", "default": "Имейл" },
        { "type": "text", "id": "email", "label": "Имейл адрес", "info": "Показва се само ако е попълнен." }
      ]
    },
    {
      "type": "phone",
      "name": "Телефон",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Етикет", "default": "Телефон" },
        { "type": "text", "id": "phone", "label": "Телефонен номер", "info": "Показва се само ако е попълнен." }
      ]
    },
    {
      "type": "social",
      "name": "Социални мрежи",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Етикет", "default": "Последвай ни" },
        { "type": "url", "id": "facebook_url", "label": "Facebook" },
        { "type": "url", "id": "instagram_url", "label": "Instagram" },
        { "type": "url", "id": "tiktok_url", "label": "TikTok" },
        {
          "type": "paragraph",
          "content": "Празно поле = връзката от Настройки на темата › Социални мрежи. Иконите без връзка не се показват. Връзките се отварят в нов раздел."
        }
      ]
    },
    {
      "type": "text",
      "name": "Текст",
      "settings": [
        { "type": "text", "id": "label", "label": "Етикет", "default": "Работно време" },
        { "type": "richtext", "id": "text", "label": "Текст", "info": "Показва се само ако е попълнен." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Контакти – форма",
      "blocks": [{ "type": "email" }, { "type": "phone" }, { "type": "social" }]
    }
  ]
}
{% endschema %}
