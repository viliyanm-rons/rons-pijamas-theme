{% comment %}
  Ron's Pijamas – customer reviews (testimonial carousel).

  Each "Review" block is one card: star rating (optional), review text,
  customer name and an optional small photo. A card is shown to customers
  only when it has both a name and review text, so empty or half-filled
  blocks never reach the storefront. Without any complete review (and no
  reviews app block) the section renders nothing for customers; the Theme
  Editor shows placeholder cards and a hint instead.

  The carousel is a native horizontal scroller with scroll snapping (touch
  swipe works without JavaScript). <rons-reviews-carousel> in
  assets/rons-custom.js adds arrows, dots, autoplay and "read more".

  Nothing here is pre-filled: names, texts, photos and ratings come only
  from the merchant (or a reviews app).
{% endcomment %}

{%- liquid
  assign review_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.name != blank and block.settings.text != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
-%}

{%- if review_count > 0 or app_blocks.size > 0 or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- capture star_icon -%}
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>
  {%- endcapture -%}

  <div class="rons-reviews color-{{ section.settings.color_scheme }} gradient{% if section.settings.grayscale_photos %} rons-reviews--grayscale{% endif %}">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="rons-reviews__header rons-reviews__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="rons-reviews__heading inline-richtext {{ section.settings.heading_size }}" id="RonsReviewsHeading-{{ section.id }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="rons-reviews__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if review_count == 0 and request.design_mode -%}
        <p class="rons-editor-hint">
          Добави истински отзиви (име, текст, по желание оценка и снимка). Карта се показва на клиентите само когато
          има име и текст. Дотогава разделът е скрит за клиентите.
        </p>
      {%- endif -%}

      <rons-reviews-carousel
        class="rons-reviews__carousel"
        role="region"
        aria-roledescription="карусел"
        {% if section.settings.heading != blank %}
          aria-labelledby="RonsReviewsHeading-{{ section.id }}"
        {% else %}
          aria-label="Отзиви от клиенти"
        {% endif %}
        data-autoplay="{{ section.settings.autoplay }}"
        data-interval="{{ autoplay_ms }}"
        style="--rons-reviews-per-view: {{ section.settings.columns_desktop }};"
      >
        <ul class="rons-reviews__track" role="list" tabindex="-1" data-track>
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign is_complete = false
              if block.settings.name != blank and block.settings.text != blank
                assign is_complete = true
              endif
              if is_complete == false and request.design_mode == false
                continue
              endif
              assign slide_index = slide_index | plus: 1
              assign rating = block.settings.rating | plus: 0
            -%}
            <li
              class="rons-reviews__slide{% if is_complete == false %} rons-reviews__slide--placeholder{% endif %}"
              role="group"
              aria-roledescription="слайд"
              data-slide
              {{ block.shopify_attributes }}
            >
              <figure class="rons-review-card">
                {%- if rating > 0 -%}
                  <span class="rons-stars rons-review-card__stars" role="img" aria-label="Оценка {{ rating }} от 5">
                    {%- for i in (1..5) -%}
                      <span class="{% if i > rating %}rons-star--empty{% endif %}">{{ star_icon }}</span>
                    {%- endfor -%}
                  </span>
                {%- endif -%}

                <blockquote class="rons-review-card__text" id="RonsReviewText-{{ block.id }}" data-review-text>
                  {%- if is_complete -%}
                    <p>{{ block.settings.text | escape | newline_to_br }}</p>
                  {%- else -%}
                    <p>Текст на отзива – видим за клиентите само след като добавиш име и текст.</p>
                  {%- endif -%}
                </blockquote>
                <button
                  type="button"
                  class="rons-review-card__more link"
                  aria-controls="RonsReviewText-{{ block.id }}"
                  aria-expanded="false"
                  data-label-more="Прочети целия отзив"
                  data-label-less="Скрий"
                  data-review-more
                  hidden
                >
                  Прочети целия отзив
                </button>

                <figcaption class="rons-review-card__author">
                  <span class="rons-review-card__who">
                    <span class="rons-review-card__name">
                      {%- if block.settings.name != blank -%}
                        {{ block.settings.name | escape }}
                      {%- else -%}
                        Име на клиентката
                      {%- endif -%}
                    </span>
                    {%- if block.settings.location != blank -%}
                      <span class="rons-review-card__location">{{ block.settings.location | escape }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.photo != blank -%}
                    {%- liquid
                      assign photo_alt = block.settings.photo.alt
                      if photo_alt == blank
                        assign photo_alt = 'Снимка от ' | append: block.settings.name
                      endif
                    -%}
                    <span class="rons-review-card__photo">
                      {{
                        block.settings.photo
                        | image_url: width: 240
                        | image_tag:
                          loading: 'lazy',
                          widths: '80, 160, 240',
                          sizes: '80px',
                          alt: photo_alt
                      }}
                    </span>
                  {%- endif -%}
                </figcaption>
              </figure>
            </li>
          {%- endfor -%}
        </ul>

        <div class="rons-reviews__controls" data-controls hidden>
          <button type="button" class="rons-reviews__arrow" data-prev aria-label="Предишен отзив">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="rons-reviews__dots" data-dots></div>
          <button type="button" class="rons-reviews__arrow rons-reviews__arrow--next" data-next aria-label="Следващ отзив">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      </rons-reviews-carousel>

      {%- for block in app_blocks -%}
        <div class="rons-reviews__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews (photos)",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 13,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add genuine reviews only. A card is shown to customers only when it has a name and review text; empty review blocks are hidden automatically."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Думи от нашите клиентки"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Истински впечатления, споделени с нас."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Visible cards on desktop",
      "info": "Tablet shows 2 cards, mobile shows 1.",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Pauses on hover, focus and when the visitor uses the carousel. Off for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 6
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "grayscale_photos",
      "label": "Show photos in black and white",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "info": "e.g. first name and initial."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "info": "Copy the genuine review word for word."
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Star rating (optional)",
          "options": [
            { "value": "0", "label": "Don't show a rating" },
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ],
          "default": "0"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo (optional)",
          "info": "Shown as a small thumbnail. Only use photos the customer has agreed to share."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews (photos)",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
