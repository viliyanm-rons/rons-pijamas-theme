{% comment %}
  Ron's Pijamas – Instagram.
  Editorial header (eyebrow, heading, @handle) and a follow button around an
  app block: the latest posts come from an Instagram feed app that the
  store owner installs and connects to the account (Instagram only gives
  posts to apps the owner authorises). Add the app's block to this section
  in the Theme Editor. Without an app block, customers see the header and
  the follow button only.

  Follower count: Instafeed doesn't provide the account's follower count
  (its feed data leaves it empty), so the merchant types the current figure
  from Instagram in the Theme Editor and updates it by hand. A plain number
  ("5240") is shown grouped ("5 240"); empty hides the line.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign profile_url = section.settings.profile_url | default: settings.social_instagram_link
  assign has_feed = false
  for block in section.blocks
    if block.type == '@app'
      assign has_feed = true
    endif
  endfor

  # Follower count: group a plain number in threes with non-breaking spaces.
  assign followers_raw = section.settings.follower_count | strip
  assign followers = followers_raw | remove: ' ' | remove: ' ' | remove: ' '
  assign followers_check = followers | plus: 0 | round | abs | append: ''
  assign followers_label = section.settings.follower_label | strip
  if followers != blank and followers_check == followers
    if followers == '1' and section.settings.follower_label_one != blank
      assign followers_label = section.settings.follower_label_one | strip
    endif
    assign digits = followers | split: ''
    assign followers = ''
    for digit in digits
      assign followers = followers | append: digit
      assign left = digits.size | minus: forloop.index | modulo: 3
      if left == 0 and forloop.last == false
        assign followers = followers | append: ' '
      endif
    endfor
  else
    assign followers = followers_raw | escape
  endif
-%}

<div class="rons-instagram color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="rons-instagram__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rons-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rons-instagram__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank and profile_url != blank -%}
        <a href="{{ profile_url }}" class="rons-instagram__handle link underlined-link" target="_blank" rel="noopener">
          {{- section.settings.handle | escape -}}
        </a>
      {%- endif -%}
      {%- if followers != blank -%}
        <p class="rons-instagram__followers">
          {%- if section.settings.follower_icon != 'none' -%}
            <span class="rons-instagram__followers-icon">
              {%- render 'rons-outline-icon', icon: section.settings.follower_icon -%}
            </span>
          {%- endif -%}
          <span>
            <span class="rons-instagram__followers-count">{{ followers }}</span>
            {%- if followers_label != blank %} {{ followers_label | escape }}{% endif -%}
          </span>
        </p>
      {%- endif -%}
    </div>

    {%- if has_feed -%}
      <div class="rons-instagram__feed">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="rons-editor-hint rons-instagram__hint">
        Инсталирай приложение за Instagram feed от Shopify App Store, свържи профила @rons_pijamas и добави блока на
        приложението тук (Добави блок › Приложения). Дотогава клиентите виждат само заглавието и бутона.
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and profile_url != blank -%}
      <div class="rons-instagram__actions">
        <a href="{{ profile_url }}" class="button button--secondary" target="_blank" rel="noopener">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Instagram",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "Последвай ни в Instagram"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Размер на заглавието",
      "options": [
        { "value": "h2", "label": "Малко" },
        { "value": "h1", "label": "Средно" },
        { "value": "h0", "label": "Голямо" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Профил (текст)",
      "default": "@rons_pijamas"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Връзка към профила",
      "info": "Ако е празно, се използва връзката от Настройки на темата › Социални мрежи."
    },
    {
      "type": "header",
      "content": "Брой последователи"
    },
    {
      "type": "paragraph",
      "content": "Instafeed не предоставя броя последователи, затова той не се обновява автоматично. Въведи точния текущ брой от профила в Instagram и го обновявай ръчно. Ако полето е празно, редът не се показва."
    },
    {
      "type": "text",
      "id": "follower_count",
      "label": "Брой последователи",
      "info": "Само цифри, напр. 5240 (показва се като „5 240“). Не въвеждай приблизителен или непроверен брой."
    },
    {
      "type": "text",
      "id": "follower_label",
      "label": "Текст след броя",
      "default": "последователи"
    },
    {
      "type": "text",
      "id": "follower_label_one",
      "label": "Текст след броя (за 1)",
      "default": "последовател"
    },
    {
      "type": "select",
      "id": "follower_icon",
      "label": "Икона",
      "options": [
        { "value": "users", "label": "Хора" },
        { "value": "instagram", "label": "Instagram" },
        { "value": "none", "label": "Без икона" }
      ],
      "default": "users"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Бутон",
      "default": "Последвай ни"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Цветова схема",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Отстъп отгоре",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Отстъп отдолу",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Instagram"
    }
  ]
}
{% endschema %}
